# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Serverless Postgres Database (Drizzle ORM)
DATABASE_URL=

# Clerk Authentication (SaaS Hosted Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk billing plan key used for pro-tier checks
CLERK_PRO_PLAN_KEY=

# Liveblocks (realtime presence, comments, collaboration)
LIVEBLOCKS_SECRET_KEY=

# Google Gemini (Notes AI Refine)
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash
